[Unit]
Description=Xray VLESS + REALITY server
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=xray-server
Image=localhost/xray-server:26.3.27

PublishPort=443:443

Volume=xray-server-warp.volume:/var/lib/warp

Secret=xray-server-private-key,type=env,target=XRAY_PRIVATE_KEY

ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
AddCapability=NET_BIND_SERVICE

[Service]
Restart=on-failure
RestartPreventExitStatus=23

[Install]
WantedBy=multi-user.target
